<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LuminaAI Studio - HD Photo & Cinematic Editor</title>
    <style>
        :root {
            --bg-main: #0b0b0f;
            --bg-card: #16161f;
            --bg-elevated: #20202e;
            --primary: #8b5cf6;
            --secondary: #ec4899;
            --success: #10b981;
            --text-light: #f8fafc;
            --text-dim: #94a3b8;
            --border: #2a2a3c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-light);
            padding-bottom: 80px;
            overflow-x: hidden;
        }

        /* Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background: rgba(22, 22, 31, 0.95);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.3px;
        }

        .credit-pill {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            box-shadow: 0 2px 10px rgba(139, 92, 246, 0.3);
        }

        /* Views */
        .view-section {
            display: none;
            padding: 16px;
            animation: fadeIn 0.25s ease;
        }

        .view-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* YouTube Style Home */
        .hero-card {
            background: linear-gradient(135deg, #2e1065 0%, #831843 100%);
            border-radius: 16px;
            padding: 22px 18px;
            text-align: center;
            margin-bottom: 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .hero-card h1 {
            font-size: 20px;
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .hero-card p {
            font-size: 13px;
            color: #e2e8f0;
            margin-bottom: 16px;
        }

